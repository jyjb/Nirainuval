            மாறுநிலை குறி: உரை = பைட்டைஉரையாக்கு(நிலை, (*நிலை).தற்போதையபைட்);
            பைட்எண்ணிக்கை = பைட்எண்ணிக்கை + 1;
            என்றால் (பைட்எண்ணிக்கை > (*நிலை).சொல்எல்லை) {
                பிழையைப்பதி(நிலை, "RESOURCE_LIMIT_SIZE", "பாதுகாத்த உரை 1024 பைட் எல்லையை மீறுகிறது");
                நிறுத்து;
            }
            உரைமதிப்பு = உரையில்சேர்(நிலை, உரைமதிப்பு, குறி);
            முன்னேறு(நிலை);
        }
    }
    (*புலமதிப்பு).உரைமதிப்பு = உரைமதிப்பு;
    (*புலமதிப்பு).வகைப்பெயர் = "text";
}

// கோவைக்கணுக்கள் ஆவணத்திற்குச் சொந்தமானவை; செயற்குறிச் சங்கிலிகள் இணைப்புப்பட்டியல்.
செயல்பாடு பாதுகாப்பற்ற புதியகோவைக்கணு(நிலை: முகவரி<பகுப்புநிலை>, இனம்: உரை): முகவரி<கோவைக்கணு> {
    என்றால் (! ஒதுக்கலாமா(நிலை, அளவு(கோவைக்கணு))) { விளைவு காலி; }
    மாறுநிலை குறி: முகவரி<கோவைக்கணு> = ஒதுக்கு கோவைக்கணு;
    என்றால் (! ஒதுக்கீட்டைப்பதி(நிலை, குறி, அளவு(கோவைக்கணு))) { விளைவு காலி; }
    (*குறி).இனம் = இனம்;
    (*குறி).மதிப்பு = காலி;
    (*குறி).முதல்சேய் = காலி;
    (*குறி).கடைசிச்சேய் = காலி;
    (*குறி).அடுத்து = காலி;
    விளைவு குறி;
}
செயல்பாடு பாதுகாப்பற்ற கோவைஇடைவெளி(நிலை: முகவரி<பகுப்புநிலை>): வெற்று {
    வரை (! (*நிலை).பிழைஉள்ளதா) {
        மாறுநிலை பைட்: முழுஎண் = (*நிலை).தற்போதையபைட்;
        என்றால் ((பைட் != 32) மற்றும் (பைட் != 9) மற்றும் (பைட் != 10)) { நிறுத்து; }
        முன்னேறு(நிலை);
    }
}
செயல்பாடு பாதுகாப்பற்ற கோவைஅணு(நிலை: முகவரி<பகுப்புநிலை>, ஆழம்: முழுஎண்): முகவரி<கோவைக்கணு> {
    கோவைஇடைவெளி(நிலை);
    என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
    என்றால் (கோப்புமுடிவா(நிலை)) {
        பிழையைப்பதி(நிலை, "UNCLOSED_EXPRESSION", "கோவைக்கு முடிவுக்குறி தேவை");
        விளைவு காலி;
    }
    என்றால் ((*நிலை).தற்போதையபைட் == 123) { விளைவு கோவைக்குழு(நிலை, ஆழம் + 1); }
    மாறுநிலை குறி: முகவரி<கோவைக்கணு> = புதியகோவைக்கணு(நிலை, "scalar");
    என்றால் (குறி == காலி) { விளைவு காலி; }
    மாறுநிலை மதிப்பு: முகவரி<புலம்> = புதியபுலம்(நிலை);
    என்றால் (மதிப்பு == காலி) { விளைவு காலி; }
    (*குறி).மதிப்பு = மதிப்பு;
    (*மதிப்பு).இனம் = "scalar";
    என்றால் ((*நிலை).தற்போதையபைட் == 60) {
        என்றால் (முன்பைட்டைபார்(நிலை, 0) == 124) {
            பிழையைப்பதி(நிலை, "INVALID_EXPRESSION", "மூலஉரை கோவையின் செயற்படுபொருளாகாது");
            விளைவு காலி;
        }
        பாதுகாத்தஉரையைவாசி(நிலை, மதிப்பு);
    }
    இல்லை {
        மாறுநிலை தொடக்கம்: முழுஎண் = (*நிலை).கோவைபைட்கள்;
        மாறுநிலை பெயரா: இருமம் = பகுதியைவாசி(நிலை, மதிப்பு);
        என்றால் (தொடக்கம் == (*நிலை).கோவைபைட்கள்) {
            பிழையைப்பதி(நிலை, "INVALID_EXPRESSION", "கோவைச் செயற்குறிக்கு செயற்படுபொருள் தேவை");
        }
        என்றால் (பெயரா மற்றும் ((*மதிப்பு).உரைமதிப்பு == "null")) { (*மதிப்பு).வகைப்பெயர் = "null"; }
    }
    விளைவு குறி;
}
// AND முதலில்; OR அதன் முடிவுகளை இணைக்கிறது. நீண்ட சங்கிலிகளுக்கு மீளழைப்பு இல்லை.
செயல்பாடு பாதுகாப்பற்ற கோவைச்சங்கிலி(நிலை: முகவரி<பகுப்புநிலை>, ஆழம்: முழுஎண், அல்லதுவா: இருமம்): முகவரி<கோவைக்கணு> {
    மாறுநிலை முதல்: முகவரி<கோவைக்கணு> = காலி;
    என்றால் (அல்லதுவா) { முதல் = கோவைச்சங்கிலி(நிலை, ஆழம், பொய்); }
    இல்லை { முதல் = கோவைஅணு(நிலை, ஆழம்); }
    மாறுநிலை குழு: முகவரி<கோவைக்கணு> = காலி;
    மாறுநிலை பைட்: முழுஎண் = 38;
    மாறுநிலை இனம்: உரை = "and";
    என்றால் (அல்லதுவா) { பைட் = 124; இனம் = "or"; }
    வரை (! (*நிலை).பிழைஉள்ளதா) {
        கோவைஇடைவெளி(நிலை);
        என்றால் ((*நிலை).தற்போதையபைட் != பைட்) { நிறுத்து; }
        என்றால் (முன்பைட்டைபார்(நிலை, 0) != பைட்) { நிறுத்து; }
        முன்னேறு(நிலை);
        முன்னேறு(நிலை);
        மாறுநிலை சேய்: முகவரி<கோவைக்கணு> = காலி;
        என்றால் (அல்லதுவா) { சேய் = கோவைச்சங்கிலி(நிலை, ஆழம், பொய்); }
        இல்லை { சேய் = கோவைஅணு(நிலை, ஆழம்); }
        என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
        என்றால் (குழு == காலி) {
            குழு = புதியகோவைக்கணு(நிலை, இனம்);
            என்றால் (குழு == காலி) { விளைவு காலி; }
            (*குழு).முதல்சேய் = முதல்;
            (*குழு).கடைசிச்சேய் = முதல்;
        }
        மாறுநிலை இறுதி: முகவரி<கோவைக்கணு> = (*குழு).கடைசிச்சேய்;
        (*இறுதி).அடுத்து = சேய்;
        (*குழு).கடைசிச்சேய் = சேய்;
    }
    என்றால் (குழு != காலி) { விளைவு குழு; }
    விளைவு முதல்;
}
செயல்பாடு பாதுகாப்பற்ற கோவைக்குழு(நிலை: முகவரி<பகுப்புநிலை>, ஆழம்: முழுஎண்): முகவரி<கோவைக்கணு> {
    என்றால் (ஆழம் > (*நிலை).ஆழஎல்லை) {
        பிழையைப்பதி(நிலை, "RESOURCE_LIMIT_DEPTH", "கோவைக்குழுவின் ஆழம் எல்லையை மீறுகிறது");
        விளைவு காலி;
    }
    முன்னேறு(நிலை);
    மாறுநிலை குறி: முகவரி<கோவைக்கணு> = கோவைச்சங்கிலி(நிலை, ஆழம், மெய்);
    என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
    என்றால் ((*நிலை).தற்போதையபைட் != 125) {
        என்றால் (கோப்புமுடிவா(நிலை)) { பிழையைப்பதி(நிலை, "UNCLOSED_EXPRESSION", "கோவைக்கு முடிவுக்குறி தேவை"); }
        இல்லை { பிழையைப்பதி(நிலை, "INVALID_EXPRESSION", "கோவையில் செயற்குறி அல்லது முடிவுக்குறி தேவை"); }
        விளைவு காலி;
    }
    முன்னேறு(நிலை);
    விளைவு குறி;
}
செயல்பாடு பாதுகாப்பற்ற கோவையைவாசி(நிலை: முகவரி<பகுப்புநிலை>, புலமதிப்பு: முகவரி<புலம்>): வெற்று {
    (*நிலை).கோவைவாசிப்பா = மெய்;
    (*நிலை).கோவைமூலம் = "";
    (*நிலை).கோவைபைட்கள் = 0;
    (*புலமதிப்பு).கோவை = கோவைக்குழு(நிலை, 1);
    (*நிலை).கோவைவாசிப்பா = பொய்;
    (*புலமதிப்பு).உரைமதிப்பு = (*நிலை).கோவைமூலம்;
    (*புலமதிப்பு).வகைப்பெயர் = "expression";
}

செயல்பாடு பாதுகாப்பற்ற பதிவில்சாவிஉள்ளதா(பதிவுமதிப்பு: முகவரி<பதிவு>, சாவி: உரை): இருமம் {
    மாறுநிலை புலக்குறி: முகவரி<புலம்> = (*பதிவுமதிப்பு).முதல்புலம்;
    வரை (புலக்குறி != காலி) {
        என்றால் ((*புலக்குறி).சாவி == சாவி) { விளைவு மெய்; }
        புலக்குறி = (*புலக்குறி).அடுத்து;
    }
    விளைவு பொய்;
}

செயல்பாடு பாதுகாப்பற்ற பதிவில்புலத்தைச்சேர்(பதிவுமதிப்பு: முகவரி<பதிவு>, புலமதிப்பு: முகவரி<புலம்>): வெற்று {
    என்றால் ((*பதிவுமதிப்பு).முதல்புலம் == காலி) {
        (*பதிவுமதிப்பு).முதல்புலம் = புலமதிப்பு;
        (*பதிவுமதிப்பு).கடைசிப்புலம் = புலமதிப்பு;
    }
    இல்லை {
        மாறுநிலை இறுதி: முகவரி<புலம்> = (*பதிவுமதிப்பு).கடைசிப்புலம்;
        (*இறுதி).அடுத்து = புலமதிப்பு;
        (*பதிவுமதிப்பு).கடைசிப்புலம் = புலமதிப்பு;
    }
}

செயல்பாடு பாதுகாப்பற்ற சிக்கல்இலக்கமா(பைட்: எழுத்து): இருமம் {
    என்றால் (பைட் == '0') { விளைவு மெய்; }
    என்றால் (பைட் == '1') { விளைவு மெய்; }
    என்றால் (பைட் == '2') { விளைவு மெய்; }
    என்றால் (பைட் == '3') { விளைவு மெய்; }
    என்றால் (பைட் == '4') { விளைவு மெய்; }
    என்றால் (பைட் == '5') { விளைவு மெய்; }
    என்றால் (பைட் == '6') { விளைவு மெய்; }
    என்றால் (பைட் == '7') { விளைவு மெய்; }
    என்றால் (பைட் == '8') { விளைவு மெய்; }
    என்றால் (பைட் == '9') { விளைவு மெய்; }
    விளைவு பொய்;
}

செயல்பாடு பாதுகாப்பற்ற சிக்கலெண்ணா(மதிப்பு: உரை): இருமம் {
    மாறுநிலை நீளம்: முழுஎண் = உரைநீளம்(மதிப்பு);
    என்றால் (நீளம் == 0) { விளைவு பொய்; }
    மாறுநிலை இடம்: முழுஎண் = 0;
    என்றால் ((மதிப்பு[0] == '-') அல்லது (மதிப்பு[0] == '+')) { இடம் = 1; }
    என்றால் (இடம் == நீளம்) { விளைவு பொய்; }
    மாறுநிலை இலக்கம்உள்ளதா: இருமம் = பொய்;
    மாறுநிலை புள்ளிஉள்ளதா: இருமம் = பொய்;
    வரை (இடம் < நீளம்) {
        மாறுநிலை பைட்: எழுத்து = மதிப்பு[இடம்];
        என்றால் (சிக்கல்இலக்கமா(பைட்)) { இலக்கம்உள்ளதா = மெய்; }
        இல்லை {
            என்றால் (பைட் == '.') {
                என்றால் (புள்ளிஉள்ளதா) { விளைவு பொய்; }
                புள்ளிஉள்ளதா = மெய்;
            }
