செயல்பாடு பாதுகாப்பற்ற ஜெசன்கணுவைஎழுது(கணுமதிப்பு: முகவரி<கணு>): வெற்று {
    எழுது("{");
    மாறுநிலை முதல்_பண்பு: இருமம் = மெய்;
    மாறுநிலை பதிவு_குறி: முகவரி<பதிவு> = (*கணுமதிப்பு).முதல்பதிவு;
    வரை (பதிவு_குறி != காலி) {
        மாறுநிலை புலக்குறி: முகவரி<புலம்> = (*பதிவு_குறி).முதல்புலம்;
        வரை (புலக்குறி != காலி) {
            என்றால் (! முதல்_பண்பு) { எழுது(","); }
            ஜெசன்சரத்தைஎழுது((*புலக்குறி).சாவி);
            எழுது(":");
            ஜெசன்புலத்தைஎழுது(புலக்குறி);
            முதல்_பண்பு = பொய்;
            புலக்குறி = (*புலக்குறி).அடுத்து;
        }
        பதிவு_குறி = (*பதிவு_குறி).அடுத்து;
    }
    மாறுநிலை சேய்: முகவரி<கணு> = (*கணுமதிப்பு).முதல்சேய்;
    வரை (சேய் != காலி) {
        என்றால் (! முதல்_பண்பு) { எழுது(","); }
        ஜெசன்சரத்தைஎழுது((*சேய்).பெயர்);
        எழுது(":");
        ஜெசன்கணுவைஎழுது(சேய்);
        முதல்_பண்பு = பொய்;
        சேய் = (*சேய்).அடுத்தஉடன்பிறப்பு;
    }
    எழுது("}");
}

செயல்பாடு பாதுகாப்பற்ற ஜெசன்ஆவணத்தைஎழுது(வேர்: முகவரி<கணு>): வெற்று {
    ஜெசன்கணுவைஎழுது(வேர்);
நார்மல்எல்லைஎழுது();
}

// பார்வைக்கான காட்சி மட்டும்; இது தரவு வரிசையாக்கி அல்ல.
செயல்பாடு பாதுகாப்பற்ற இடைவெளியைக்காட்டு(ஆழம்: முழுஎண்): வெற்று {
    மாறுநிலை சுட்டெண்: முழுஎண் = 0;
    வரை (சுட்டெண் < ஆழம்) {
        எழுது("  ");
        சுட்டெண் = சுட்டெண் + 1;
    }
}

செயல்பாடு பாதுகாப்பற்ற சிக்கல்வரிசையைக்காட்டு(முதல்: முகவரி<சிக்கல்வரிசைஉறுப்பு>): வெற்று {
    எழுது("?[");
    மாறுநிலை உறுப்பு: முகவரி<சிக்கல்வரிசைஉறுப்பு> = முதல்;
    மாறுநிலை முதற்பதிவு: இருமம் = மெய்;
    வரை (உறுப்பு != காலி) {
        என்றால் (! முதற்பதிவு) { எழுது("+"); }
        என்றால் ((*உறுப்பு).இனம் == "array") {
            சிக்கல்வரிசையைக்காட்டு((*உறுப்பு).முதல்வரிசைஉறுப்பு);
        }
        இல்லை {
            எழுது((*உறுப்பு).உரைமதிப்பு);
            எழுது(":");
            எழுது((*உறுப்பு).வகைப்பெயர்);
        }
        முதற்பதிவு = பொய்;
        உறுப்பு = (*உறுப்பு).அடுத்து;
    }
    எழுது("]");
}

செயல்பாடு பாதுகாப்பற்ற புலத்தைக்காட்டு(புலமதிப்பு: முகவரி<புலம்>, ஆழம்: முழுஎண்): வெற்று {
    இடைவெளியைக்காட்டு(ஆழம்);
    எழுது((*புலமதிப்பு).சாவி);
    எழுது("=");
    என்றால் ((*புலமதிப்பு).இனம் == "null") {
        காண்("null");
    }
    இல்லை {
        என்றால் ((*புலமதிப்பு).இனம் == "complex_array") {
            சிக்கல்வரிசையைக்காட்டு((*புலமதிப்பு).சிக்கல்முதலுறுப்பு);
            காண்("");
        }
        இல்லை {
        என்றால் ((*புலமதிப்பு).இனம் == "array") {
            எழுது("[");
            மாறுநிலை உறுப்பு: முகவரி<வரிசைஉறுப்பு> = (*புலமதிப்பு).முதல்வரிசைஉறுப்பு;
            மாறுநிலை முதல்: இருமம் = மெய்;
            வரை (உறுப்பு != காலி) {
                என்றால் (! முதல்) { எழுது(","); }
                எழுது((*உறுப்பு).உரைமதிப்பு);
                எழுது(":");
                எழுது((*உறுப்பு).வகைப்பெயர்);
                முதல் = பொய்;
                உறுப்பு = (*உறுப்பு).அடுத்து;
            }
            காண்("]");
        }
        இல்லை {
            எழுது((*புலமதிப்பு).உரைமதிப்பு);
            எழுது(":");
            காண்((*புலமதிப்பு).வகைப்பெயர்);
        }
        }
    }
}

செயல்பாடு பாதுகாப்பற்ற பதிவைக்காட்டு(பதிவுமதிப்பு: முகவரி<பதிவு>, ஆழம்: முழுஎண்): வெற்று {
    மாறுநிலை புலக்குறி: முகவரி<புலம்> = (*பதிவுமதிப்பு).முதல்புலம்;
    வரை (புலக்குறி != காலி) {
        புலத்தைக்காட்டு(புலக்குறி, ஆழம்);
        புலக்குறி = (*புலக்குறி).அடுத்து;
    }
}

செயல்பாடு பாதுகாப்பற்ற கணுவைக்காட்டு(கணுமதிப்பு: முகவரி<கணு>, ஆழம்: முழுஎண்): வெற்று {
    இடைவெளியைக்காட்டு(ஆழம்);
    எழுது("* ");
    காண்((*கணுமதிப்பு).பெயர்);

    மாறுநிலை பதிவுக்குறி: முகவரி<பதிவு> = (*கணுமதிப்பு).முதல்பதிவு;
    வரை (பதிவுக்குறி != காலி) {
        பதிவைக்காட்டு(பதிவுக்குறி, ஆழம் + 1);
        பதிவுக்குறி = (*பதிவுக்குறி).அடுத்து;
    }

    மாறுநிலை குறி: முகவரி<கணு> = (*கணுமதிப்பு).முதல்சேய்;
    வரை (குறி != காலி) {
        கணுவைக்காட்டு(குறி, ஆழம் + 1);
        குறி = (*குறி).அடுத்தஉடன்பிறப்பு;
    }
}

// தொகுக்கப்பட்ட மாதிரிச்சோதனைகள்; அழைப்பிடக் கோப்பகத்தைச் சார்ந்தவை அல்ல.
செயல்பாடு பாதுகாப்பற்ற சோதனைக்கோப்புப்பாதை(பெயர்: உரை): உரை {
    மாறுநிலை வேர்: உரை = சூழல்_பெறு("NSDXN_FIXTURE_ROOT");
    மாறுநிலை நீளம்: முழுஎண் = உரைநீளம்(வேர்) + உரைநீளம்(பெயர்) + 2;
    மாறுநிலை இடம்: முகவரி = நினைவைஅளி(நீளம்);
    என்றால் (இடம் == காலி) { விளைவு ""; }
    மாறுநிலை பாதை: உரை = உரையைதொடங்கு(இடம், வேர்);
    உரையைநீட்டு(பாதை, "/");
    உரையைநீட்டு(பாதை, பெயர்);
    விளைவு பாதை;
}

செயல்பாடு பாதுகாப்பற்ற ஒருங்குறிக்கோப்பைதிற(நிலை: முகவரி<பகுப்புநிலை>, பாதை: உரை): முகவரி {
    மாறுநிலை நீளம்: முழுஎண் = உரைநீளம்(பாதை);
    // Each UTF-8 byte can expand to one UTF-16 code unit at minimum; the
    // two-byte allocation also covers surrogate pairs and the terminating NUL.
    மாறுநிலை அகலப்பாதை: உரை = உரைநினைவைஅளி(நிலை, (நீளம் * 2) + 2);
    மாறுநிலை அகலமுறை: உரை = உரைநினைவைஅளி(நிலை, 8);
    என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
    மாறுநிலை பாதைஅகலம்: முழுஎண் = utf8அகலமாக்கு(65001, 8, பாதை, 0 - 1, அகலப்பாதை, நீளம் + 1);
    மாறுநிலை முறைஅகலம்: முழுஎண் = utf8அகலமாக்கு(65001, 8, "rb", 0 - 1, அகலமுறை, 4);
    என்றால் ((பாதைஅகலம் <= 0) அல்லது (முறைஅகலம் <= 0)) { விளைவு காலி; }
    விளைவு அகலக்கோ_திற(அகலப்பாதை, அகலமுறை);
}

// getenv is ANSI on the bootstrap Windows CRT. Read the process input through
// the Unicode Win32 environment API first, then hand the parser a UTF-8 path.
செயல்பாடு பாதுகாப்பற்ற ஒருங்குறிச்சூழல்பெறு(பெயர்: உரை): உரை {
    மாறுநிலை பெயர்அகலம்: உரை = ஜெசன்நினைவைஅளி(128);
    மாறுநிலை மதிப்புஅகலம்: உரை = ஜெசன்நினைவைஅளி(131072);
    மாறுநிலை வெளியீடு: உரை = ஜெசன்நினைவைஅளி(131072);
    மாறுநிலை பெயர்நீளம்: முழுஎண் = utf8அகலமாக்கு(65001, 8, பெயர், 0 - 1, பெயர்அகலம், 64);
    என்றால் (பெயர்நீளம் <= 0) {
        உரையைவிடுவி(பெயர்அகலம்); உரையைவிடுவி(மதிப்புஅகலம்); உரையைவிடுவி(வெளியீடு);
        விளைவு "";
    }
    மாறுநிலை மதிப்புநீளம்: முழுஎண் = ஒருங்குறிச்சூழல்அளவு(பெயர்அகலம், மதிப்புஅகலம், 65536);
    என்றால் (மதிப்புநீளம் <= 0) {
        உரையைவிடுவி(பெயர்அகலம்); உரையைவிடுவி(மதிப்புஅகலம்); உரையைவிடுவி(வெளியீடு);
        விளைவு "";
    }
    மாறுநிலை utf8நீளம்: முழுஎண் = அகலutf8ஆக்கு(65001, 0, மதிப்புஅகலம், மதிப்புநீளம், வெளியீடு, 131072, காலி, காலி);
    உரையைவிடுவி(பெயர்அகலம்);
    உரையைவிடுவி(மதிப்புஅகலம்);
    என்றால் (utf8நீளம் <= 0) { உரையைவிடுவி(வெளியீடு); விளைவு ""; }
    விளைவு வெளியீடு;
}

செயல்பாடு பாதுகாப்பற்ற சோதனையைஇயக்கு(பாதை: உரை, சோதனைப்பெயர்: உரை, பிழையைஎதிர்பார்: இருமம், எதிர்பார்த்தகுறியீடு: உரை): வெற்று {
    மாறுநிலை சோதனைநிலை: முகவரி<பகுப்புநிலை> = புதியபகுப்புநிலை();
    என்றால் (சோதனைநிலை == காலி) { விளைவு; }
    (*சோதனைநிலை).கோப்பு = ஒருங்குறிக்கோப்பைதிற(சோதனைநிலை, பாதை);
    என்றால் ((*சோதனைநிலை).கோப்பு == காலி) {
        எழுது("[FAIL open] ");
        காண்(சோதனைப்பெயர்);
    }
    இல்லை {
        முன்னேறு(சோதனைநிலை);
        மாறுநிலை வேர்: முகவரி<கணு> = ஆவணத்தைப்பகு(சோதனைநிலை);
        என்றால் (பிழையைஎதிர்பார்) {
            என்றால் (! (*சோதனைநிலை).பிழைஉள்ளதா) {
                எழுது("[FAIL expected-error] ");
                காண்(சோதனைப்பெயர்);
            }
            இல்லை {
                என்றால் ((*சோதனைநிலை).பிழைக்குறியீடு != எதிர்பார்த்தகுறியீடு) {
                    எழுது("[FAIL wrong-code expected=");
                    எழுது(எதிர்பார்த்தகுறியீடு);
                    எழுது(" got=");
                    எழுது((*சோதனைநிலை).பிழைக்குறியீடு);
                    எழுது("] ");
                    காண்(சோதனைப்பெயர்);
                }
                இல்லை {
                    எழுது("[PASS] ");
                    காண்(சோதனைப்பெயர்);
                }
            }
        }
        இல்லை {
            என்றால் ((*சோதனைநிலை).பிழைஉள்ளதா) {
                எழுது("[FAIL unexpected-error code=");
                எழுது((*சோதனைநிலை).பிழைக்குறியீடு);
                எழுது(" line=");
                எழுது((*சோதனைநிலை).பிழைவரி);
                எழுது("] ");
                காண்(சோதனைப்பெயர்);
            }
            இல்லை {
                எழுது("[PASS] ");
                காண்(சோதனைப்பெயர்);
                கணுவைக்காட்டு(வேர், 1);
            }
        }
    }    என்றால் ((*சோதனைநிலை).கோப்பு != காலி) { கோ_மூடு((*சோதனைநிலை).கோப்பு); }
    ஆவணநினைவைவிடுவி(சோதனைநிலை);
    நினைவைவிடுவி(சோதனைநிலை);
    என்றால் (பாதை != "") { உரையைவிடுவி(பாதை); }
}

// Aingnyazhi hosted entry points do not currently receive argv.  NSDXN_INPUT
// therefore provides the supported single-file process interface used by the
// PowerShell CLI wrapper and editor/tool integrations.
செயல்பாடு பாதுகாப்பற்ற ஒரேகோப்பைப்பகு(பாதை: உரை): முழுஎண் {
    மாறுநிலை நிலை: முகவரி<பகுப்புநிலை> = புதியபகுப்புநிலை();
    என்றால் (நிலை == காலி) {
        காண்("NSDXN_ERROR code=OUT_OF_MEMORY line=0");
        விளைவு 2;
    }
    (*நிலை).கோப்பு = ஒருங்குறிக்கோப்பைதிற(நிலை, பாதை);
    என்றால் ((*நிலை).கோப்பு == காலி) {
        காண்("NSDXN_ERROR code=FILE_OPEN_FAILED line=0");
        ஆவணநினைவைவிடுவி(நிலை);
        நினைவைவிடுவி(நிலை);
        விளைவு 2;
    }

    முன்னேறு(நிலை);
    மாறுநிலை வேர்: முகவரி<கணு> = ஆவணத்தைப்பகு(நிலை);
    என்றால் ((*நிலை).பிழைஉள்ளதா) {
        எழுது("NSDXN_ERROR code=");
        எழுது((*நிலை).பிழைக்குறியீடு);
        எழுது(" line=");
        எழுது((*நிலை).பிழைவரி);
        எழுது(" column=");
        காண்((*நிலை).பிழைநெடுவரி);
        கோ_மூடு((*நிலை).கோப்பு);
        ஆவணநினைவைவிடுவி(நிலை);
        நினைவைவிடுவி(நிலை);
        விளைவு 1;
    }

    மாறுநிலை முறை: உரை = "";
    என்றால் (சூழல்_முகவரி("NSDXN_MODE") != காலி) { முறை = சூழல்_பெறு("NSDXN_MODE"); }
    என்றால் (முறை == "normal") {
        நார்மல்ஆவணத்தைஎழுது(வேர்);
    }
    இல்லை {
        என்றால் ((முறை == "pretty") அல்லது (முறை == "minified")) {
            நார்மல்ஆவணத்தைஎழுது(வேர்);
        }
        இல்லை {
            என்றால் (முறை == "nanofied") {
                நானோஆவணத்தைஎழுது(வேர்);
            }
        இல்லை {
            என்றால் (முறை == "json") {
            ஜெசன்ஆவணத்தைஎழுது(வேர்);
            }
            இல்லை {
                காண்("NSDXN_OK");
                நார்மல்ஆவணத்தைஎழுது(வேர்);
            }
        }
        }
    }
    கோ_மூடு((*நிலை).கோப்பு);
    ஆவணநினைவைவிடுவி(நிலை);
    நினைவைவிடுவி(நிலை);
    விளைவு 0;
}

