                                மாறுநிலை சிக்கல்முந்தையஉறுப்பு: முகவரி<சிக்கல்வரிசைஉறுப்பு> = காலி;
                                என்றால் (((*நிலை).சிக்கல்உரிமைப்புலம் != காலி) மற்றும் ((*நிலை).சிக்கல்உரிமையாழம் + 1 == ஆழம்) மற்றும் ((*நிலை).சிக்கல்உரிமைபெற்றோர் == பெற்றோர்)) {
                                    சிக்கல்முந்தையஉறுப்பு = சிக்கல்உறுப்பைத்தேர்((*நிலை).சிக்கல்உரிமைப்புலம், பெயர்);
                                }
                                என்றால் ((சிக்கல்முந்தையஉறுப்பு != காலி) மற்றும் ((*சிக்கல்முந்தையஉறுப்பு).இனம் == "named_array")) {
                                    சிக்கல்பெயரிட்டவரிசைப்பகு(நிலை, சிக்கல்முந்தையஉறுப்பு, பெயர், ஆழம்);
                                }
                                இல்லை { சிக்கல்வரிசைப்பதிவைப்பகு(நிலை, பெற்றோர், பெயர், ஆழம்); }
                            }
                            இல்லை {
                            என்றால் ((*நிலை).தற்போதையபைட் == 61) {
                                மாறுநிலை பதிவுமதிப்பு: முகவரி<பதிவு> = பதிவைப்பகு(நிலை, பெயர்);
                                என்றால் (! (*நிலை).பிழைஉள்ளதா) {
                                    கணுவில்பதிவைச்சேர்(பெற்றோர், பதிவுமதிப்பு);
                                    (*நிலை).கடைசிப்பதிவு = பதிவுமதிப்பு;
                                    (*நிலை).கடைசிப்பதிவின்பெற்றோர் = பெற்றோர்;
                                    (*நிலை).கடைசிப்பதிவுஆழம் = ஆழம்;
                                    (*நிலை).கடைசிப்பதிவுவரி = (*நிலை).வரி;
                                    (*நிலை).கடைசிக்கூற்றுஆழம் = ஆழம்;
                                    (*நிலை).கடைசிக்கூற்றுஇலையா = மெய்;
                                }
                            }
                            இல்லை {
                                மாறுநிலை சேய்க்கணு: முகவரி<கணு> = புதியகணுவைஉருவாக்கு(நிலை, பெயர்);
                                என்றால் (சேய்க்கணு == காலி) { விளைவு காலி; }
                                என்றால் (((*நிலை).தற்போதையபைட் == 35) அல்லது ((*நிலை).தற்போதையபைட் == 40)) {
                                    அட்டவணைவரையறையைப்பகு(நிலை, சேய்க்கணு, "");
                                }
                                இல்லை {
                                    என்றால் (! (((*நிலை).தற்போதையபைட் == 10) அல்லது (கோப்புமுடிவா(நிலை)))) {
                                        பிழையைப்பதி(நிலை, "INVALID_IDENTIFIER", "= குறி அல்லது கணு அறிவிப்பின் முடிவு எதிர்பார்க்கப்பட்டது");
                                    }
                                }
                                என்றால் (! (*நிலை).பிழைஉள்ளதா) {
                                    மாறுநிலை சிக்கல்உறுப்பு: முகவரி<சிக்கல்வரிசைஉறுப்பு> = காலி;
                                    என்றால் (((*நிலை).சிக்கல்உரிமைப்புலம் != காலி) மற்றும் ((*நிலை).சிக்கல்உரிமையாழம் + 1 == ஆழம்) மற்றும் ((*நிலை).சிக்கல்உரிமைபெற்றோர் == பெற்றோர்)) {
                                        சிக்கல்உறுப்பு = சிக்கல்உறுப்பைத்தேர்((*நிலை).சிக்கல்உரிமைப்புலம், பெயர்);
                                    }
                                    என்றால் (சிக்கல்உறுப்பு != காலி) {
                                        என்றால் ((*சேய்க்கணு).அட்டவணைமதிப்பு != காலி) {
                                            (*சிக்கல்உறுப்பு).இனம் = "named_table";
                                            (*சிக்கல்உறுப்பு).வகைப்பெயர் = "table";
                                        }
                                        இல்லை {
                                            (*சிக்கல்உறுப்பு).இனம் = "named_object";
                                            (*சிக்கல்உறுப்பு).வகைப்பெயர் = "object";
                                        }
                                        (*சிக்கல்உறுப்பு).பெயர் = பெயர்;
                                        (*சிக்கல்உறுப்பு).உட்கணு = சேய்க்கணு;
                                    }
                                    இல்லை { கணுவில்சேயைச்சேர்(பெற்றோர், சேய்க்கணு); }
                                    அடுக்கு[ஆழம்] = சேய்க்கணு;
                                    (*நிலை).அடுக்குநீளம் = ஆழம் + 1;
                                    (*நிலை).கடைசிக்கூற்றுஆழம் = ஆழம்;
                                    (*நிலை).கடைசிக்கூற்றுஇலையா = பொய்;
                                    (*நிலை).கடைசிப்பதிவு = காலி;
                                }
                            }
                            }
                        }
                    }
                }
                }
            }
        }
    }
    என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
    பதிவுகளைஅட்டவணையாக்கு(நிலை, வேர், 0);
    என்றால் ((*நிலை).பிழைஉள்ளதா) { விளைவு காலி; }
    கணுவகைகளைஒத்திசை(வேர்);
    விளைவு வேர்;
}

செயல்பாடு பாதுகாப்பற்ற நார்மல்சாய்வைஎழுது(ஆழம்: முழுஎண்): வெற்று {
    மாறுநிலை குறி: முழுஎண் = 0;
    மாறுநிலை முறை: உரை = "";
    என்றால் (சூழல்_முகவரி("NSDXN_MODE") != காலி) { முறை = சூழல்_பெறு("NSDXN_MODE"); }
    என்றால் (முறை == "pretty") {
        வரை (குறி < ஆழம் * 2) { எழுது(" "); குறி = குறி + 1; }
    }
    இல்லை { வரை (குறி < ஆழம்) { எழுது("/"); குறி = குறி + 1; } }
}

செயல்பாடு பாதுகாப்பற்ற நார்மல்எல்லைஎழுது(): வெற்று {
    மாறுநிலை முறை: உரை = "";
    என்றால் (சூழல்_முகவரி("NSDXN_MODE") != காலி) { முறை = சூழல்_பெறு("NSDXN_MODE"); }
    என்றால் (முறை != "minified") { காண்(""); }
}

செயல்பாடு பாதுகாப்பற்ற நார்மல்உரைபாதுகாப்புதேவை(மதிப்பு: உரை, வகை: உரை): இருமம் {
    என்றால் (வகை != "text") { விளைவு பொய்; }
    மாறுநிலை நீளம்: முழுஎண் = உரைநீளம்(மதிப்பு);
    என்றால் (நீளம் == 0) { விளைவு பொய்; }
    என்றால் ((மதிப்பு == "true") அல்லது (மதிப்பு == "false") அல்லது (மதிப்பு == "null")) { விளைவு மெய்; }
    மாறுநிலை குறி: முழுஎண் = 0;
    வரை (குறி < நீளம்) {
        என்றால் ((உரையில்தேடு(மதிப்பு, "\r\n \t") != காலி) அல்லது
            (மதிப்பு[குறி] == '+') அல்லது (மதிப்பு[குறி] == '=') அல்லது (மதிப்பு[குறி] == '|') அல்லது (மதிப்பு[குறி] == '<') அல்லது
            (மதிப்பு[குறி] == '>') அல்லது (மதிப்பு[குறி] == '#') அல்லது (மதிப்பு[குறி] == '?') அல்லது (மதிப்பு[குறி] == '[') அல்லது
            (மதிப்பு[குறி] == ']') அல்லது (மதிப்பு[குறி] == '{') அல்லது (மதிப்பு[குறி] == '}') அல்லது (மதிப்பு[குறி] == '/') அல்லது
            (மதிப்பு[குறி] == '(') அல்லது (மதிப்பு[குறி] == ')')) { விளைவு மெய்; }
        குறி = குறி + 1;
    }
    // Unprotected values beginning with a digit are subject to numeric/date/
    // time inference. Preserve them as text even when they contain no delimiter.
    என்றால் ((மதிப்பு[0] == '0') அல்லது (மதிப்பு[0] == '1') அல்லது (மதிப்பு[0] == '2') அல்லது
        (மதிப்பு[0] == '3') அல்லது (மதிப்பு[0] == '4') அல்லது (மதிப்பு[0] == '5') அல்லது
        (மதிப்பு[0] == '6') அல்லது (மதிப்பு[0] == '7') அல்லது (மதிப்பு[0] == '8') அல்லது (மதிப்பு[0] == '9')) { விளைவு மெய்; }
    விளைவு பொய்;
}

செயல்பாடு பாதுகாப்பற்ற நார்மல்உரையைஎழுது(மதிப்பு: உரை, வகை: உரை): வெற்று {
    என்றால் (! நார்மல்உரைபாதுகாப்புதேவை(மதிப்பு, வகை)) {
        எழுது(மதிப்பு);
        விளைவு;
    }
    மாறுநிலை நீளம்: முழுஎண் = உரைநீளம்(மதிப்பு);
    மாறுநிலை மூலஉரை: இருமம் = உரையில்தேடு(மதிப்பு, "\r\n>|") != காலி;
    என்றால் (மூலஉரை) {
        எழுது("<|");
        மாறுநிலை நகல்: உரை = ஜெசன்நினைவைஅளி(நீளம் + 1);
        ஜெசன்நகலைதொடங்கு(நகல், மதிப்பு);
        மாறுநிலை துண்டு: முகவரி = ஜெசன்துண்டாக்கு(நகல், "|");
        மாறுநிலை சுட்டு: முழுஎண் = 0;
        வரை (துண்டு != காலி) {
            ஜெசன்துண்டுஎழுது("%s", துண்டு);
            சுட்டு = சுட்டு + ஜெசன்துண்டுநீளம்(துண்டு);
            வரை ((சுட்டு < நீளம்) மற்றும் (மதிப்பு[சுட்டு] == '|')) {
                எழுது("||");
                சுட்டு = சுட்டு + 1;
            }
            துண்டு = ஜெசன்தொடர்துண்டாக்கு(காலி, "|");
        }
        உரையைவிடுவி(நகல்);
        எழுது("|>");
    }
    இல்லை {
        எழுது("<");
        எழுது(மதிப்பு);
        எழுது(">");
    }
}

செயல்பாடு பாதுகாப்பற்ற சிக்கல்வரிசைநார்மலாகஎழுது(முதல்உறுப்பு: முகவரி<சிக்கல்வரிசைஉறுப்பு>): வெற்று {
    எழுது("?[");
    மாறுநிலை உறுப்பு: முகவரி<சிக்கல்வரிசைஉறுப்பு> = முதல்உறுப்பு;
    மாறுநிலை முதல்: இருமம் = மெய்;
    வரை (உறுப்பு != காலி) {
        என்றால் (! முதல்) { எழுது("+"); }
        என்றால் ((*உறுப்பு).இனம் == "array") { சிக்கல்வரிசைநார்மலாகஎழுது((*உறுப்பு).முதல்வரிசைஉறுப்பு); }
        இல்லை {
            எழுது((*உறுப்பு).உரைமதிப்பு);
            என்றால் ((*உறுப்பு).இனம் == "named_table") { எழுது("#"); }
            இல்லை {
                என்றால் ((*உறுப்பு).இனம் == "named_array") { எழுது("?"); }
            }
        }
        முதல் = பொய்;
        உறுப்பு = (*உறுப்பு).அடுத்து;
    }
    எழுது("]");
}

செயல்பாடு பாதுகாப்பற்ற புலமதிப்பைநார்மலாகஎழுது(புலமதிப்பு: முகவரி<புலம்>): வெற்று {
    என்றால் ((*புலமதிப்பு).இனம் == "complex_array") { சிக்கல்வரிசைநார்மலாகஎழுது((*புலமதிப்பு).சிக்கல்முதலுறுப்பு); }
    இல்லை {
        என்றால் ((*புலமதிப்பு).இனம் == "null") { எழுது("null"); }
        இல்லை {
            என்றால் ((*புலமதிப்பு).இனம் == "array") {
                எழுது("[");
                மாறுநிலை உறுப்பு: முகவரி<வரிசைஉறுப்பு> = (*புலமதிப்பு).முதல்வரிசைஉறுப்பு;
                மாறுநிலை முதல்: இருமம் = மெய்;
                வரை (உறுப்பு != காலி) {
                    என்றால் (! முதல்) { எழுது("+"); }
                    நார்மல்உரையைஎழுது((*உறுப்பு).உரைமதிப்பு, (*உறுப்பு).வகைப்பெயர்);
                    முதல் = பொய்;
                    உறுப்பு = (*உறுப்பு).அடுத்து;
                }
                எழுது("]");
            }
            இல்லை { நார்மல்உரையைஎழுது((*புலமதிப்பு).உரைமதிப்பு, (*புலமதிப்பு).வகைப்பெயர்); }
        }
    }
